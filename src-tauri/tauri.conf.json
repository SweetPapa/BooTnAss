{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOOT N ASS",
  "version": "1.2.0",
  "identifier": "com.sweetpapatech.bootnass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BOOT N ASS",
        "width": 1366,
        "height": 768,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#040612",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "publisher": "Sweet Papa Technologies",
    "copyright": "© 2026 Sweet Papa Technologies",
    "homepage": "https://github.com/SweetPapa/BooTnAss",
    "shortDescription": "Retro Synthwave 3D On-Rails Arcade Space Shooter",
    "longDescription": "BOOT N ASS is a high-octane 3D neon rail shooter featuring voiced animated cutscenes, multi-phase bosses, Zorp's Hangar upgrades, and full gamepad support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.3"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
